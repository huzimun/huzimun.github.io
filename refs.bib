% BibTeX 参考文献库
% 将你的论文 BibTeX 条目粘贴到这里，然后运行 python bib2qmd.py 自动生成论文列表页
% 可从 Google Scholar / DBLP / arXiv 一键导出 BibTeX 格式

@article{example2025journal,
  title   = {Deep Learning for Vision Tasks: A Survey},
  author  = {Your Name and Coauthor Name},
  journal = {Journal of Example Research},
  year    = {2025},
  volume  = {1},
  number  = {2},
  pages   = {1--20},
  doi     = {10.1000/example.2025}
}

@inproceedings{example2025cvpr,
  title     = {A Novel Approach to Sample Problem},
  author    = {Your Name and Coauthor Name},
  booktitle = {Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year      = {2025},
  pages     = {100--110},
  doi       = {10.1000/cvpr.2025}
}

@misc{example2026preprint,
  title         = {Working Paper Title},
  author        = {Your Name},
  year          = {2026},
  eprint        = {2508.00000},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CV}
}
